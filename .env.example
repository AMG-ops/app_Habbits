# Local development values. docker-compose already sets these; this file is
# only useful if you run the API outside a container.
DATABASE_URL=postgresql+psycopg://habitude:habitude@localhost:5432/habitude
JWT_SECRET=dev-secret-not-for-production

# SMTP for password-reset codes. Leave empty to just log the code to the
# server console instead of sending an email (fine for local dev).
# Example for Gmail: host smtp.gmail.com, port 587, your address as the
# username, and a 16-character App Password (not your normal password) —
# https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Habitude <no-reply@habitude.app>
SMTP_USE_TLS=true
